[Unit]
Description=TRAMONE main script
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WorkingDirectory=/home/pi/TRAMONE
ExecStart=/bin/bash /home/pi/TRAMONE/tramone_main.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
